# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.*

# Auction state snapshots (runtime data). The glob covers the per-pool dirs
# `main._default_state_dir()` derives for an alternate FCHL_PLAYERS_CSV,
# e.g. data/state-players-23-converted/.
data/state*/

# Dropped-in copy of the pricer repo (source of model_params.json) — not part of this project
FCHL-auction-pricer/

# OS
.DS_Store
Thumbs.db

# Reference material dropped in data/ for a human to read — league workbooks
# and the DobberHockey guides. Not inputs to anything: nothing in the app or
# the tests opens them, and they are third-party publications. Four of them
# (17MB, two PDFs of 9.4MB and 6.0MB) were swept into a commit by `git add -A`
# on 2026-09-10, which is why this rule is by extension rather than by name.
data/*.pdf
data/*.xlsx

# LibreOffice lock files (created while a data workbook is open)
.~lock.*#
